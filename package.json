{
  "name": "stratum-game-discovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test src/discovery.test.js",
    "test:e2e": "playwright test",
    "data:fetch": "python scripts/fetch-google-play.py",
    "data:curate": "python scripts/curate-google-play.py",
    "data:refresh": "npm run data:fetch && npm run data:curate",
    "data:details": "python scripts/fetch-play-details.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "vite": "^6.1.0"
  }
}
