{
  "name": "stratum-game-discovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test src/discovery.test.js scripts/play-import.test.mjs scripts/play-frontier.test.mjs src/i18n.test.js src/content-i18n.test.js scripts/game-categories.test.mjs scripts/gameplay-tags.test.mjs src/image-preview.test.js",
    "test:e2e": "playwright test",
    "data:fetch": "python scripts/fetch-google-play.py",
    "data:curate": "python scripts/curate-google-play.py",
    "data:refresh": "npm run data:fetch && npm run data:curate",
    "data:details": "python scripts/fetch-play-details.py",
    "data:scan": "node scripts/scan-google-play.mjs",
    "data:import-recent": "node scripts/import-recent-games.mjs",
    "data:expand": "node scripts/expand-google-play.mjs",
    "data:translate": "node scripts/translate-content.mjs",
    "data:puzzles": "node scripts/scan-puzzle-games.mjs",
    "data:hypercasual": "node scripts/scan-hypercasual-games.mjs",
    "images:previews": "python scripts/build-image-previews.py",
    "prebuild": "npm run images:previews"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "google-play-scraper": "10.1.3",
    "vite": "^6.1.0"
  }
}
